{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "flaw_id", "owasp", "actor", "proof", "explanation", "fix", "status"],
  "anyOf": [{"required": ["table"]}, {"required": ["column"]}, {"required": ["function"]}],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "minLength": 1},
    "flaw_id": {"enum": ["R1", "R2", "R3", "R4", "R5", "R6", "R7", "C1", "C2", "V1", "U1", "U2", "U3"]},
    "owasp": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "table": {"type": "string", "minLength": 1},
    "column": {"type": "string", "minLength": 1},
    "function": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "proof": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "explanation": {"type": "string", "minLength": 1},
    "fix": {"type": "string", "minLength": 1},
    "status": {"enum": ["proved", "needs_decision"]}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe", "actor", "statement", "result", "rows_seen", "error"],
      "properties": {
        "probe": {"type": "string"},
        "actor": {"type": "string"},
        "statement": {"type": "string"},
        "result": {"enum": ["ok", "permission_denied", "error"]},
        "rows_seen": {"type": "array", "items": {"type": "object"}},
        "error": {"type": ["string", "null"]}
      }
    }
  }
}
