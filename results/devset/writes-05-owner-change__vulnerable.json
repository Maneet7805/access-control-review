  "findings": [
    {
      "actor": "user:11111111-1111-1111-1111-111111111111",
      "explanation": "A signed-in user can change who owns a row in the table \"notes\", handing it to another user.",
      "fix": "Add a check to the update policy on \"notes\" so a changed row must still have \"owner_id\" equal to the user's own user id (auth.uid()). In SQL this is the WITH CHECK part of the policy.",
      "flaw_id": "R7",
      "id": "R7:notes:user:11111111-1111-1111-1111-111111111111",
      "owasp": [
        "A01",
        "API1"
      ],
      "proof": [
        {
